    { "name": "@carbon/icon-helpers", "dir": "icon-helpers" },
    { "name": "@carbon/icons", "dir": "icons" },
    { "name": "@carbon/icons-react", "dir": "icons-react" },
    { "name": "@carbon/icons-vue", "dir": "icons-vue" },
    { "name": "@carbon/layout", "dir": "layout" },
    { "name": "@carbon/motion", "dir": "motion" },
    { "name": "@carbon/pictograms", "dir": "pictograms" },
    { "name": "@carbon/pictograms-react", "dir": "pictograms-react" },
    { "name": "@carbon/react", "dir": "react" },
    { "name": "@carbon/styles", "dir": "styles" },
    { "name": "@carbon/themes", "dir": "themes" },
    { "name": "@carbon/type", "dir": "type" },
